{
  "name": "agent-decision-firewall",
  "version": "0.1.0",
  "description": "Model-agnostic AI Agent Decision Firewall and Evaluation Harness (JEV / LAYA adapters)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json",
    "firewall": "tsx src/cli/bin.ts",
    "ci": "npm run typecheck && npm test"
  },
  "bin": {
    "firewall": "./bin/firewall.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  }
}
